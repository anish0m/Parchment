# Copy to .env and adjust. Docker Compose and manage.py both read it.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

POSTGRES_DB=parchment
POSTGRES_USER=parchment
POSTGRES_PASSWORD=parchment

# Inside Docker Compose the host is "db"; for a Postgres on your machine use localhost.
DATABASE_URL=postgres://parchment:parchment@db:5432/parchment

# Outgoing email (password reset). Dev prints emails to the console instead.
# EMAIL_URL=smtp+tls://user:password@smtp.example.com:587
# DJANGO_DEFAULT_FROM_EMAIL=Parchment <noreply@example.com>
