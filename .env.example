# Copy to .env and adjust. Docker Compose and manage.py both read it.
# For production (docker-compose.prod.yml), see "Deployment" in the README: use a
# long random secret key, DEBUG off, your domain, and a strong database password.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# DJANGO_CSRF_TRUSTED_ORIGINS=https://parchment.example.com
# Cards come due at midnight in this time zone.
# DJANGO_TIME_ZONE=UTC

POSTGRES_DB=parchment
POSTGRES_USER=parchment
POSTGRES_PASSWORD=parchment

# Inside Docker Compose the host is "db"; for a Postgres on your machine use localhost.
DATABASE_URL=postgres://parchment:parchment@db:5432/parchment

# Outgoing email (password reset). Dev prints emails to the console instead.
# EMAIL_URL=smtp+tls://user:password@smtp.example.com:587
# DJANGO_DEFAULT_FROM_EMAIL=Parchment <noreply@example.com>

# Upload limits for study materials.
# MATERIAL_MAX_UPLOAD_MB=20
# MATERIAL_MAX_PDF_PAGES=300
# MATERIAL_MAX_TEXT_CHARS=300000

# Flashcard generation. With a Gemini or Anthropic API key, an LLM writes
# the cards; without one (or if the API fails) the built-in rules do.
# GEMINI_API_KEY=AIza...           # free tier available at aistudio.google.com
# ANTHROPIC_API_KEY=sk-ant-...     # paid
# CARD_GENERATOR=auto              # auto | gemini | claude | rules
# CARD_GENERATION_GEMINI_MODEL=gemini-flash-latest
# ANSWER_GRADER=auto               # checks typed answers: auto | gemini | claude | local
# CARD_GENERATION_MODEL=claude-opus-5
# CARD_GENERATION_EFFORT=medium    # low | medium | high
# EMBEDDING_BACKEND=auto           # auto | sentence-transformers | tfidf

# Background worker (python manage.py qcluster). Q_SYNC=True runs tasks inline,
# without a worker, e.g. for quick local runs.
# Q_WORKERS=2
# Q_SYNC=False
# Q_POLL=0.2                      # seconds between queue checks
# RUN_WORKER=0                     # 1 starts the worker inside the web container

# Rate limits (per user; failed sign-ins per IP address).
# RATE_LIMIT_UPLOADS=30/hour
# RATE_LIMIT_GENERATION=20/hour
# RATE_LIMIT_LOGIN=30/hour

# Production only (docker-compose.prod.yml).
# DJANGO_SECURE_SSL_REDIRECT=True   # False only if nothing in front terminates TLS
# DJANGO_SECURE_HSTS_SECONDS=0      # e.g. 31536000 once HTTPS works
# DJANGO_LOG_FORMAT=json            # json | text
# WEB_CONCURRENCY=3
# WEB_PORT=8000
# WORKER_MEMORY=2g
# BACKUP_INTERVAL_SECONDS=86400
# BACKUP_KEEP_DAYS=7
